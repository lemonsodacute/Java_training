{
  "info": {
    "name": "Employee Management - Module 1-4",
    "_postman_id": "employee-management-demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUsername}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "admin123"
    }
  ],
  "item": [
    {
      "name": "Module 1 - Hello",
      "item": [
        {
          "name": "GET Hello",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/hello",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Module 2 - Bean",
      "item": [
        {
          "name": "GET Code EMP-0012",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/utils/code/12",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Module 3 - ArrayList",
      "item": [
        {
          "name": "GET Demo Employees",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/demo/employees",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST Demo Employee",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/demo/employees",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyen Van An\",\n  \"email\": \"an@gmail.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Module 4 - MySQL",
      "item": [
        {
          "name": "POST Department",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/departments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"IT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET Departments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments",
            "header": []
          }
        },
        {
          "name": "POST Employee",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/employees",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyen Van An\",\n  \"email\": \"an@gmail.com\",\n  \"departmentId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET All Employees",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/employees",
            "header": []
          }
        },
        {
          "name": "GET Search Name",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/employees?name=An",
            "header": []
          }
        },
        {
          "name": "GET Search Department",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/employees?departmentId=1",
            "header": []
          }
        },
        {
          "name": "PUT Employee 1",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/employees/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyen Van An (Edited)\",\n  \"email\": \"an@gmail.com\",\n  \"departmentId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE Employee 1",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/employees/1",
            "header": []
          }
        }
      ]
    }
  ]
}
